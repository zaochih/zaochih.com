{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaochih-com",
  "compatibility_date": "2026-09-13",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
