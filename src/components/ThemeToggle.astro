---
import Icon from './Icon.astro';

interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button
  id="theme-toggle"
  type="button"
  aria-label={label}
  class="group inline-flex h-7 w-7 items-center justify-center rounded-md text-fg-subtle transition-colors hover:bg-bg-muted hover:text-fg"
>
  <Icon name="sun-moon" data-icon="auto" class="h-3.75 w-3.75" />
  <Icon name="sun" data-icon="light" class="hidden h-3.75 w-3.75" />
  <Icon name="moon" data-icon="dark" class="hidden h-3.75 w-3.75" />
</button>

<script>
  // This script's content is identical on every locale page, so Astro's view
  // transitions only ever run it once (see `deselectScripts` in astro's
  // swap-functions). It must not hold onto element references from a
  // particular page — re-query the live button on every call, and bind
  // listeners on `document` (which persists across transitions) instead of
  // on the button itself. `astro:after-swap` also re-applies `data-theme`
  // because the transition swap resets any runtime-set `<html>` attribute
  // that isn't part of the incoming page's static markup.
  const STORAGE_KEY = 'ui.themeMode';
  const ORDER = ['auto', 'light', 'dark'] as const;
  type Mode = (typeof ORDER)[number];

  function readStored(): Mode {
    const saved = localStorage.getItem(STORAGE_KEY);
    return saved === 'light' || saved === 'dark' ? saved : 'auto';
  }

  function apply(mode: Mode) {
    if (mode === 'auto') {
      document.documentElement.removeAttribute('data-theme');
    } else {
      document.documentElement.setAttribute('data-theme', mode);
    }
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    for (const icon of btn.querySelectorAll<SVGElement>('svg[data-icon]')) {
      icon.classList.toggle('hidden', icon.dataset.icon !== mode);
    }
  }

  apply(readStored());
  document.addEventListener('astro:after-swap', () => apply(readStored()));

  // Crossfade the switch with the View Transitions API (the same mechanism
  // ClientRouter uses for page navigation) instead of an instant hard cut.
  // Only for the explicit toggle click, not the initial/swap `apply` calls
  // above — those should never animate.
  type DocumentWithViewTransitions = Document & {
    startViewTransition?: (callback: () => void) => unknown;
  };

  function applyWithTransition(mode: Mode) {
    const doc = document as DocumentWithViewTransitions;
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    if (reduceMotion || !doc.startViewTransition) {
      apply(mode);
      return;
    }
    doc.startViewTransition(() => apply(mode));
  }

  document.addEventListener('click', (event) => {
    const btn = (event.target as Element | null)?.closest?.('#theme-toggle');
    if (!btn) return;
    const current = readStored();
    const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
    localStorage.setItem(STORAGE_KEY, next);
    applyWithTransition(next);
  });
</script>
