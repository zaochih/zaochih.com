---
import { profile, type Locale } from '../data';
import RichText from './RichText.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = profile[locale];

const themeToggleLabel: Record<Locale, string> = {
  'zh-CN': '切换主题',
  'zh-TW': '切換主題',
  'en-US': 'Toggle theme',
};
const langToggleLabel: Record<Locale, string> = {
  'zh-CN': '切换语言',
  'zh-TW': '切換語言',
  'en-US': 'Switch language',
};
const siteControlsLabel: Record<Locale, string> = {
  'zh-CN': '语言与主题',
  'zh-TW': '語言與主題',
  'en-US': 'Language and theme',
};
---

<div class="px-4.5 pb-8 pt-12 sm:px-6 sm:pb-10 sm:pt-16">
  <div class="mb-12 flex items-center justify-between">
    <h1 class="bg-[#0057b8] px-2 py-1 font-sans text-sm font-medium text-white">
      {p.handle}
    </h1>
    <nav
      class="flex items-center gap-0.5"
      aria-label={siteControlsLabel[locale]}
    >
      <LangToggle locale={locale} label={langToggleLabel[locale]} />
      <ThemeToggle label={themeToggleLabel[locale]} />
    </nav>
  </div>

  <div
    class:list={[
      'text-[19px] leading-[1.65] font-medium text-fg sm:text-[22px]',
      locale === 'en-US' && 'max-w-120',
    ]}
  >
    {p.tagline}
  </div>

  <div
    class:list={[
      'mt-7 text-[15.5px] leading-[1.9] text-fg-muted',
      locale === 'en-US' && 'max-w-125',
    ]}
  >
    <RichText text={p.bio.template} />
  </div>

  <ul class="mt-7 flex flex-wrap items-center gap-2.5 text-[14.5px]">
    {p.contact.map((item) => {
      const accessibleText = item.href.startsWith('mailto:')
        ? item.href.slice('mailto:'.length)
        : item.text;
      return (
        <li class="flex items-center gap-x-2.5 not-first:before:text-border-strong not-first:before:content-['/']">
          <a
            href={item.href}
            target="_blank"
            rel="noreferrer"
            aria-label={`${item.alt}: ${accessibleText}`}
            class="inline-flex items-center gap-1.5 text-fg-muted no-underline hover:text-fg"
          >
            {item.icon && <Icon name={item.icon} class="h-3.5 w-auto" />}
            {item.name && (
              <span class="rounded border border-border-strong px-1 py-px font-mono text-[10px] leading-none text-fg-subtle">
                {item.name}
              </span>
            )}
            <span>{item.text}</span>
          </a>
        </li>
      );
    })}
  </ul>
</div>

<section class="border-t border-border px-4.5 py-5.5 sm:px-6 sm:py-7">
  <h2 class="mb-3.5 font-sans text-[11px] font-medium tracking-wide text-fg-subtle">
    {p.eyebrows.languages}
  </h2>
  <ul class="flex flex-col gap-y-2 text-[15px] text-fg-muted sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-2.5">
    {p.languages.map((lang) => (
      <li class="flex items-center gap-x-2.5 sm:not-first:before:text-border-strong sm:not-first:before:content-['/']">
        <span class="inline-flex items-center gap-1.5">
          <span>{lang.name}</span>
          <span class="before:mr-1.5 before:text-border-strong before:content-['·']">
            {lang.level}
          </span>
        </span>
      </li>
    ))}
  </ul>
</section>

<section class="border-t border-border px-4.5 py-5.5 sm:px-6 sm:py-7">
  <h2 class="mb-3.5 font-sans text-[11px] font-medium tracking-wide text-fg-subtle">
    {p.eyebrows.tags}
  </h2>
  <ul class="flex flex-wrap items-center gap-x-2.5 gap-y-2 text-[15px] text-fg-muted">
    {p.tags.map((tag) => (
      <li class="flex items-center gap-x-2.5 not-first:before:text-border-strong not-first:before:content-['/']">
        <span class="inline-flex items-center">
          <RichText text={tag} />
        </span>
      </li>
    ))}
  </ul>
</section>

<section class="border-t border-border px-4.5 py-5.5 sm:px-6 sm:py-7">
  <h2 class="mb-3.5 font-sans text-[11px] font-medium tracking-wide text-fg-subtle">
    {p.eyebrows.beento}
  </h2>
  <ul class="flex flex-wrap items-center gap-x-2.5 gap-y-2 text-[15px] text-fg-muted">
    {p.beento.map((region) => (
      <li class="flex items-center gap-x-2.5 not-first:before:text-border-strong not-first:before:content-['/']">
        <span>{region}</span>
      </li>
    ))}
  </ul>
</section>

<footer class="border-t border-border px-4.5 py-8 font-mono text-xs text-fg-subtle sm:px-6">
  <a
    href={p.footer.href}
    target="_blank"
    rel="noreferrer"
    class="text-fg-muted hover:text-fg"
  >
    {p.footer.text}
  </a>
</footer>
